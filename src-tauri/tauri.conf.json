{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGER Designer",
  "version": "0.1.0",
  "identifier": "com.spillwave.ager-designer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "AGER Designer",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "AGER Designer — describe a multi-agent loop, draw the graph, configure tools and loop controls, export OKF.",
    "shortDescription": "Agent graph designer",
    "category": "DeveloperTool",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
